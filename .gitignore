# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/

# ---------------------------------------------------------------------------
# Build outputs
# ---------------------------------------------------------------------------
dist/
dist-electron/
out/
build/
.next/
.next-local/
.next-createx/
.turbo/
.cache/
.vercel/
*.tsbuildinfo
*.tgz
# ...except electron-builder's source resources dir, which holds tracked
# config files (entitlements, icons) — not build output.
!apps/desktop/build/
!apps/desktop/build/**

# Go binaries built into the server module root
server/bin/
server/tmp/
server/migrate
server/daemon
server/auro
server/server
server/reach
*.exe

# ---------------------------------------------------------------------------
# Tests and coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# ---------------------------------------------------------------------------
# Environment files
# ---------------------------------------------------------------------------
.env*
!.env.example
# Desktop production config is public (backend URL, etc.) — track it so
# `pnpm package` produces a release-ready build without extra setup.
!apps/desktop/.env.production
# Desktop staging config is public (staging API/web URLs) — track it so
# `pnpm dev:desktop:staging` works from a fresh checkout instead of relying
# on a hand-written local env file (MUL-5025: a misnamed VITE_ var there
# silently broke copy-link URLs).
!apps/desktop/.env.staging
# Mobile staging config is public (staging API URL) — track it so a fresh
# checkout can run `pnpm dev:mobile:staging` / `ios:mobile*:staging` without
# the user having to copy `.env.example` first.
!apps/mobile/.env.staging
# Mobile production config is public (production API URL) — track it so
# external users can run `pnpm ios:mobile:device:prod:release` against
# auro.ai's production backend without copying templates first.
!apps/mobile/.env.production
# The production example is a tracked template; `.env*` above would hide it.
!apps/mobile/.env.production.example

# ---------------------------------------------------------------------------
# Logs, PIDs, and runtime data
# ---------------------------------------------------------------------------
*.log
pnpm-debug.log*
*.pid
*.pid.lock
*~
/data/
/server/data/
.deal/
.siege/
.reach/
.auro/

# ---------------------------------------------------------------------------
# OS and editor files
# ---------------------------------------------------------------------------
.DS_Store
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Local agent and tooling state (never shared through the repository)
# ---------------------------------------------------------------------------
.context
.agent_context/
.agents/
.claude/
.codex/
.cursor/
.qoder/
.workbuddy/
.kilo
.gstack/
_features/
.tool-versions
.envrc

# Agent working notes stay local; the Siege PRD is referenced from docs.
tasks/*
!tasks/prd-siege-playability.md

# Python (agent tooling)
__pycache__/
*.pyc
.venv/
perf-report/

# Platform-specific artifacts
*.dmg
*.app
