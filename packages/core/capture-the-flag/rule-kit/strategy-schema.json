  "flag_states": [
    "AT_HOME",
    "CARRIED",
    "DROPPED"
  ],
  "flag_action_rules": "旗帜不会因接触自动拾取或归还。PICK_UP_FLAG 必须带 special.flag：OWN 表示在己方旗帜在家或掉落的位置 1 格内举起己方旗，ENEMY 表示在掉落敌旗位置 1 格内举起敌旗。敌旗 AT_HOME 时仍必须通过 CAPTURE_ENEMY_FLAG 连续夺旗 3 秒。DROP_CARRIED_FLAG 会在 Tick 开始位置放下当前持有的任意旗帜。持有任意旗帜均减速 25%，每个单位一次最多持一面旗。RETURN_OWN_DROPPED_FLAG 保留为归还己方掉落旗到旗位的显式指令。",
  "dropped_flag_timing": "持旗单位死亡或执行 DROP_CARRIED_FLAG 时，旗帜以该单位当时位置进入 DROPPED 状态。之后不会自动拾取或归还，必须由策略发出合法旗帜操作。",
  "limits": {
    "max_rules_per_unit": 20,
    "max_condition_depth": 3,
    "max_basic_conditions_per_rule": 8,
    "max_strategy_json_size_bytes": 262144
  },
  "global_readable_information": {
    "perspective": "所有字段相对当前执行策略的一方解释；ally 表示我方，enemy 表示对方，同一份策略可直接用于红方或蓝方。",
    "game_time": {
      "source": "game.time",
      "type": "number",
      "unit": "seconds",
      "description": "本局已经进行的模拟时间。"
    },
    "unit_source_format": "{ally|enemy}.{heavy_infantry|cavalry|archer}.{field}",
    "unit_fields": [
      {
        "field": "hp",
        "type": "number",
        "description": "当前生命值；死亡或等待重生时为 0。"
      },
      {
        "field": "respawn_round",
        "type": "integer",
        "description": "当前重生轮次，取值 0、1、2、3；永久出局后仍显示 3。"
      },
      {
        "field": "moved_last_1s",
        "type": "boolean",
        "description": "过去 1 秒内是否发生过实际位置变化。"
      },
      {
        "field": "is_attacking",
        "type": "boolean",
        "description": "上一策略 Tick 是否实际成功发动攻击。"
      },
      {
        "field": "attacked_last_1s",
        "type": "boolean",
        "description": "过去 1 秒内是否受到过攻击。"
      },
      {
        "field": "is_flag_carrier",
        "type": "boolean",
        "description": "当前是否持有任意旗帜。"
      },
      {
        "field": "x",
        "type": "number",
        "description": "当前横坐标，保留完整小数精度。"
      },
      {
        "field": "y",
        "type": "number",
        "description": "当前纵坐标，保留完整小数精度。"
      },
      {
        "field": "distance_to_self",
        "type": "number",
        "description": "该单位到当前执行规则单位的直线距离。"
      },
      {
        "field": "distance_to_own_flag",
        "type": "number",
        "description": "到己方旗帜当前位置的直线距离；旗被携带时跟随持旗者。"
      },
      {
        "field": "distance_to_enemy_flag",
        "type": "number",
        "description": "到敌方旗帜当前位置的直线距离；旗被携带时跟随持旗者。"
      },
      {
        "field": "distance_to_own_flag_zone",
        "type": "number",
        "description": "到己方固定旗区中心的直线距离。"
      },
      {
        "field": "distance_to_enemy_flag_zone",
        "type": "number",
        "description": "到敌方固定旗区中心的直线距离。"
      }
    ],
    "self_position": {
      "sources": [
        "self.x",
        "self.y"
      ],
      "description": "当前执行规则单位自己的精确二维坐标。"
    },
    "flag_positions": {
      "sources": [
        "own_flag.x",
        "own_flag.y",
        "enemy_flag.x",
