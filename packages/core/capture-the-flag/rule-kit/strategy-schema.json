  "priority": {
    "min": 1,
    "max": 100,
    "higher_runs_first": true
  },
  "movement_types": [
    "MOVE_TOWARD",
    "MOVE_AWAY_FROM",
    "FOLLOW",
    "GUARD",
    "INTERCEPT",
    "HOLD_POSITION",
    "RETURN_TO_OWN_FLAG",
    "GO_TO_ENEMY_FLAG",
    "GO_TO_DROPPED_FLAG"
  ],
  "movement_routes": [
    {
      "route": "UPPER_LANE_20",
      "description": "用于 GO_TO_ENEMY_FLAG 或 RETURN_TO_OWN_FLAG。单位使用连续二维坐标，以速度乘 Tick 时长沿直线移动，斜向不增加速度。去敌旗时依次经过地图中线上方路径点、敌旗上方路径点和敌旗；持旗回家时经过地图中线上方路径点后直接前往己方旗位。任意两个路径点之间允许自然斜向移动。默认 lane_offset 为 20。"
    }
  ],
  "movement_rules": "所有单位使用连续二维坐标移动，内部保留完整小数精度。每 Tick 朝目标点沿直线移动，移动距离等于速度乘 Tick 时长，斜向不增加速度。单位没有碰撞体积且不占格，任意红蓝单位都可以处于同一坐标；其他单位不会阻挡移动或重生。",
  "movement_coordinate": {
    "field": "movement.coordinate",
    "usage": "仅用于 MOVE_TOWARD，指定固定坐标作为移动目标；不能与 movement.target 同时使用。",
    "shape": {
      "x": "number",
      "y": "number"
    },
    "bounds": {
      "x": [
        0,
        99
      ],
      "y": [
        0,
        49
      ]
    },
    "example": {
      "type": "MOVE_TOWARD",
      "coordinate": {
        "x": 50,
        "y": 25
      }
    }
  },
  "spawn_rules": "每局开始与每次重生时，单位均在己方基地内随机合法位置出现，避开己方旗帜周围 2 格。随机结果由比赛种子决定，同一种子可复现。策略不能配置、指定或预测出生坐标。",
  "tick_resolution": "每个 0.25 秒策略 Tick 先以 Tick 开始时的全局快照决定全部单位行动，再按开始位置、攻击范围和冷却同时结算全部攻击；死亡单位不再移动；最后幸存单位的已计划移动位置同时提交。",
  "archer_action_timing": "弓箭手每次射箭占用当前 Tick 和紧随的下一个 Tick，共 2 Tick（0.5 秒）硬直；硬直期间不能移动或攻击。射箭攻击冷却为 4 Tick（1 秒），因此硬直结束后可以移动，但到冷却结束前不能再次射箭。",
  "attack_types": [
    "ATTACK",
    "ATTACK_NEAREST_ENEMY",
    "ATTACK_LOWEST_HP_ENEMY",
    "ATTACK_ENEMY_FLAG_CARRIER",
    "ATTACK_ENEMY_THREATENING_ALLY_FLAG_CARRIER",
    "ATTACK_RECENT_ALLY_ATTACKER",
    "NO_ATTACK"
  ],
  "attack_target_rules": "attack.target 为可选的合法单位目标。使用 ATTACK 或 ATTACK_NEAREST_ENEMY 时，指定 target 会优先攻击该目标；未指定时按 attack.type 的默认选敌逻辑执行。目标仍必须是存活敌军，且仅在进入本兵种攻击范围时才会造成伤害。",
  "special_types": [
