  "enhancement_mode": {
    "required": false,
    "default": "standard",
    "enum": [
      "standard",
      "cavalry",
      "heavy_infantry",
      "archer"
    ],
    "effects": {
      "standard": "不强化任何兵种，使用基础属性。",
      "cavalry": "骑兵移动速度增加 100%，由 5 格/秒提升至 10 格/秒。",
      "heavy_infantry": "重甲步兵最大生命值和出生/重生生命值增加 100%，由 300 提升至 600。",
      "archer": "弓箭手攻击范围增加 100%，由 5 格提升至 10 格。"
    },
    "compatibility": "旧策略缺少 enhancement_mode 时按 standard 处理。"
  },
