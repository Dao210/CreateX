      "sources": [
        "nearest_unit.id",
        "nearest_unit.relation",
        "nearest_unit.unit_type",
        "nearest_unit.distance"
      ],
      "description": "除自身外距离最近的存活单位；relation 为 ALLY、ENEMY 或 none。无其他存活单位时 id 与 unit_type 为 none，distance 为 999。"
    }
