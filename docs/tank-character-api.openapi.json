        "allOf": [
          {
            "if": {
              "properties": {
                "valid": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "blueprint"
              ],
              "properties": {
                "errors": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "errors": {
                  "minItems": 1
                }
              }
            }
          }
        ]
