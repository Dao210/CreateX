                    "required": [
                      "profile",
                      "name",
                      "parts",
                      "appearance"
                    ],
                    "properties": {
                      "profile": {
                        "const": "tank-defense@1"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                      },
                      "parts": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "chassis",
                          "armor",
                          "cannon"
                        ],
                        "properties": {
                          "chassis": {
                            "type": "string",
                            "enum": [
                              "light",
                              "standard",
                              "heavy"
                            ]
                          },
                          "armor": {
                            "type": "string",
                            "enum": [
                              "light",
                              "standard",
                              "heavy"
                            ]
                          },
                          "cannon": {
                            "type": "string",
                            "enum": [
                              "rapid",
                              "standard",
                              "heavy"
                            ]
                          }
                        }
                      },
                      "appearance": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "body",
                          "accent",
                          "pattern"
                        ],
                        "properties": {
                          "body": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "accent": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "pattern": {
                            "type": "string",
                            "enum": [
                              "solid",
                              "stripe",
                              "cross"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "expectedRevision": {
                    "maximum": 50,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "requestId": {
                    "format": "uuid",
                    "type": "string"
                  }
                },
                "required": [
