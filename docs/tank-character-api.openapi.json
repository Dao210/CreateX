  "paths": {
    "/api/tanks/v1/catalog": {
      "parameters": [
        {
          "name": "X-Workspace-ID",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getTankCatalog",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TankCatalog"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/tanks/v1/characters/validate": {
      "parameters": [
        {
          "name": "X-Workspace-ID",
          "in": "header",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "operationId": "validateTankCharacter",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "draft": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "profile",
                      "name",
                      "parts",
                      "appearance"
                    ],
                    "properties": {
                      "profile": {
                        "const": "tank-defense@1"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                      },
                      "parts": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "chassis",
                          "armor",
                          "cannon"
                        ],
                        "properties": {
                          "chassis": {
                            "type": "string",
                            "enum": [
                              "light",
                              "standard",
                              "heavy"
                            ]
                          },
                          "armor": {
                            "type": "string",
                            "enum": [
                              "light",
                              "standard",
                              "heavy"
                            ]
                          },
                          "cannon": {
                            "type": "string",
                            "enum": [
                              "rapid",
                              "standard",
                              "heavy"
                            ]
                          }
                        }
                      },
                      "appearance": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "body",
                          "accent",
                          "pattern"
                        ],
                        "properties": {
                          "body": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "accent": {
                            "type": "string",
                            "pattern": "^#[0-9a-fA-F]{6}$"
                          },
                          "pattern": {
                            "type": "string",
                            "enum": [
                              "solid",
                              "stripe",
                              "cross"
                            ]
                          }
                        }
                      }
                    }
                  }
                },
                "required": [
                  "draft"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TankValidation"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/tanks/v1/characters": {
